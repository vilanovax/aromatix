  "narrative": {
    "northStar": "میز آرام عطرساز",
    "overview": "آروما مثل میز کار تمیز یک عطرساز است: کاغذ سبز–خاکستری ملایم، جوهر تیره، بطری روی سطح روشن. نه ویترین طلایی بوتیک، نه داشبورد شلوغ. رابط باید حس دستیار صمیمی بدهد — سبک، سریع، قابل لمس روی موبایل.\n\nتراکم متوسط–کم: یک کار در هر بخش، تیتر کوتاه، یک جملهٔ پشتیبان، کنترل‌های بزرگ. عمق با لایهٔ تُنال (paper / card / moss) و سایه‌های خیلی نرم ساخته می‌شود، نه با گلو یا گرادیان بنفش.\n\nضدمرجعهای تأییدشده: بنر ترند، منوی پایین شلوغ، کارت‌های یکسان آیکون+تیتر، کلیشهٔ طلا/مشکی لوکس عطر، و آواتار ربات برای «هوشمند» نشان دادن محصول.",
    "keyCharacteristics": [
      "RTL فارسی با Vazirmatn؛ ارقام فارسی در UI",
      "پالت خنثی سبز–خاکستری + جوهر تیره؛ اکسنت فقط در آکورد و وضعیت",
      "شل موبایل max-w حدود ۳۲rem؛ دسکتاپ فقط قاب و سایهٔ محیطی",
      "امضای بصری: نوار نسبت آکورد (Accord Mark)",
      "حرکت کوتاه با ease-out و احترام به reduced-motion"
    ],
    "rules": [
      {
        "name": "The Quiet Accent Rule",
        "body": "رنگ اشباع فقط روی آکورد، وضعیت موجودی، یا حالت معنایی می‌آید — نه روی پس‌زمینهٔ کل صفحه و نه به‌عنوان تم بنفش/طلا.",
        "section": "colors"
      },
      {
        "name": "The No Luxury Cliché Rule",
        "body": "طلا، مشکی براق، و گرادیان بنفش–ایندیگو برای این محصول ممنوع‌اند مگر دارایی واقعی برند عطر در محتوا.",
        "section": "colors"
      },
      {
        "name": "The No Eyebrow Rule",
        "body": "برچسب کوچک بالای تیتر نگذار؛ تیتر خودش حرف بزند و جملهٔ پشتیبان زیرش بیاید.",
        "section": "typography"
      },
      {
        "name": "The Sixteen Rule",
        "body": "فیلدهای متنی روی موبایل کمتر از ۱۶px نشوند.",
        "section": "typography"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "سطح در حالت عادی تخت است؛ سایه پاسخ به اهمیت یا شناور بودن است نه دکور پیش‌فرض همهٔ کارت‌ها.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do مسیرهای شروع را هم‌زمان روشن نگه دار: اسم عطر، توصیف آزاد، راهنما.",
      "Do از توکن‌های --paper/--ink/--card/--moss استفاده کن؛ رنگ جدید فقط برای معنای داده.",
      "Do لمس‌پذیری و RTL را قبل از زیباسازی دسکتاپ چک کن.",
      "Do توضیح why و Accord Mark را نزدیک پیشنهاد نگه دار."
    ],
    "donts": [
      "Don't بنر ترند، منوی پایین شلوغ، یا لوگوی غول‌پیکر به هوم اضافه کن.",
      "Don't با حدس، ردیف خالی مقایسه یا پیشنهاد نامطمئن را پر کن.",
      "Don't آواتار چت یا حباب‌های تزئینی برای «دستیار» بساز.",
      "Don't Inter/Roboto/سیستم پیش‌فرض را جایگزین Vazirmatn کن.",
      "Don't تم بنفش–ایندیگو یا طلایی–مشکی لوکس پیش‌فرض AI را وارد کن."
    ]
  }
