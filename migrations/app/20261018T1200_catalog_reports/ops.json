        "sql": "CREATE TABLE \"aroma\".\"CatalogReport\" (\n  \"adminNote\" text DEFAULT '' NOT NULL,\n  \"body\" text NOT NULL,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"id\" SERIAL NOT NULL,\n  \"perfumeSlug\" text NOT NULL,\n  \"resolvedAt\" timestamptz,\n  \"status\" text DEFAULT 'open' NOT NULL,\n  \"topic\" text NOT NULL,\n  \"userId\" int4,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"CatalogReport_status_check_8eef8884\" CHECK (\"status\" IN ('open', 'fixed', 'dismissed')),\n  CONSTRAINT \"CatalogReport_topic_check_14ecc761\" CHECK (\"topic\" IN ('price', 'identity', 'scent', 'shop', 'other'))\n)",
